# Development/demo only. Never expose demo mode on a public host.
ENVIRONMENT=development
RELAND_DEMO_MODE=1
GOOGLE_CLIENT_ID=
RELAND_DB=./data/reland.sqlite
# Production (Vercel + Neon): set pooled DATABASE_URL instead of RELAND_DB
# DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Managed Better Auth (Neon Console → Auth → Base URL)
NEON_AUTH_BASE_URL=
COOKIE_SECURE=0
# Admin key used ONLY in X-Admin-Key header on server (never placed in client JS)
RELAND_ADMIN_KEY=replace-with-long-random-value
# Optional real consultation notification. Without SMTP no professional routing occurs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONSULTATION_NOTIFY_EMAIL=
